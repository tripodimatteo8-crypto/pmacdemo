{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
-%}

{% if section.settings.show_social and social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div class="pmac-marquee-bar color-{{ section.settings.color_scheme }} gradient">
  <div class="pmac-phase-chip pmac-mono" title="{%- render 'pmac-phase-label' -%}">
    <span class="pmac-phase-chip__dot" aria-hidden="true"></span>
    <span class="pmac-phase-chip__full">{%- render 'pmac-phase-label' -%}</span>
    <span class="pmac-phase-chip__short">{%- render 'pmac-phase-label', short: true -%}</span>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div
      class="pmac-marquee"
      data-speed="{{ section.settings.speed }}"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      <div class="pmac-marquee__track pmac-mono">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="pmac-marquee__item" {{ block.shopify_attributes }}>{%- else -%}<span class="pmac-marquee__item" {{ block.shopify_attributes }}>{%- endif -%}
              {{ block.settings.text | escape }}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
            <span class="pmac-marquee__sep" aria-hidden="true">//</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if settings.enable_pmac_sound -%}
    <button type="button" class="pmac-sound-toggle pmac-mono" data-pmac-sound-toggle aria-pressed="false" aria-label="Sound">
      <span class="pmac-sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span data-sound-label>SOUND OFF</span>
    </button>
    <script type="application/json" id="PmacSoundFiles">
      {
        "click": {{ 'pmac-sfx-click.mp3' | asset_url | json }},
        "ping": {{ 'pmac-sfx-ping.mp3' | asset_url | json }},
        "warp": {{ 'pmac-sfx-warp.mp3' | asset_url | json }},
        "launch": {{ 'pmac-sfx-launch.mp3' | asset_url | json }},
        "add": {{ 'pmac-sfx-add.mp3' | asset_url | json }},
        "drone": {{ 'pmac-sfx-drone.mp3' | asset_url | json }}
      }
    </script>
    <script src="{{ 'pmac-sound.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if section.settings.show_social and social_icons -%}
    <div class="pmac-marquee-bar__social">
      {%- render 'social-icons' -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pmac-phase-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    height: 100%;
    padding: 0 1.4rem;
    border-right: 1px solid rgba(var(--color-foreground), 0.14);
    background: rgb(var(--color-background));
    position: relative;
    z-index: 1;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--color-foreground));
  }

  .pmac-phase-chip__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--pmac-signal);
    animation: pmac-phase-blink 1.4s steps(1) infinite;
  }

  .pmac-phase-chip__short {
    display: none;
  }

  [data-pmac-phase='4'] .pmac-phase-chip {
    color: var(--pmac-signal);
  }

  @keyframes pmac-phase-blink {
    50% {
      opacity: 0.2;
    }
  }

  @media screen and (max-width: 749px) {
    .pmac-phase-chip {
      padding: 0 1rem;
    }

    .pmac-phase-chip__full {
      display: none;
    }

    .pmac-phase-chip__short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pmac-phase-chip__dot {
      animation: none;
    }
  }

  .pmac-marquee-bar {
    display: flex;
    align-items: center;
    height: 3.6rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.14);
  }

  .pmac-sound-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    height: 100%;
    padding: 0 1.4rem;
    border: 0;
    border-left: 1px solid rgba(var(--color-foreground), 0.14);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1rem;
    letter-spacing: 0.14em;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .pmac-sound-toggle:hover,
  .pmac-sound-toggle.is-on {
    color: rgb(var(--color-foreground));
  }

  .pmac-sound-toggle__bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 1rem;
  }

  .pmac-sound-toggle__bars i {
    display: block;
    width: 2px;
    height: 2px;
    background: currentColor;
    transition: height 300ms ease;
  }

  .pmac-sound-toggle.is-on .pmac-sound-toggle__bars i {
    animation: pmac-sound-eq 900ms ease-in-out infinite alternate;
  }

  .pmac-sound-toggle.is-on .pmac-sound-toggle__bars i:nth-child(2) { animation-delay: -300ms; }
  .pmac-sound-toggle.is-on .pmac-sound-toggle__bars i:nth-child(3) { animation-delay: -600ms; }
  .pmac-sound-toggle.is-on .pmac-sound-toggle__bars i:nth-child(4) { animation-delay: -150ms; }

  @keyframes pmac-sound-eq {
    from { height: 2px; }
    to { height: 1rem; }
  }

  @media screen and (max-width: 749px) {
    .pmac-sound-toggle {
      padding: 0 1rem;
    }

    .pmac-sound-toggle [data-sound-label] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pmac-sound-toggle.is-on .pmac-sound-toggle__bars i {
      animation: none;
      height: 0.8rem;
    }
  }

  .pmac-marquee-bar .pmac-marquee {
    height: 100%;
    flex: 1;
    min-width: 0;
  }

  .pmac-marquee__item {
    display: inline-flex;
    padding: 0 0.4em;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    white-space: nowrap;
  }

  a.pmac-marquee__item {
    transition: opacity var(--dur-fast) var(--ease-pmac);
  }

  a.pmac-marquee__item:hover {
    opacity: 0.6;
  }

  .pmac-marquee__sep {
    display: inline-flex;
    align-items: center;
    opacity: 0.4;
    font-size: 1.1rem;
  }

  .pmac-marquee-bar__social {
    flex: none;
    padding: 0 1.6rem;
    border-left: 1px solid rgba(var(--color-foreground), 0.14);
  }

  .pmac-marquee-bar__social .list-social {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Velocità scorrimento (px/s)",
      "default": 60
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
