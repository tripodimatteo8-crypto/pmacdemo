{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
-%}

{% if section.settings.show_social and social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div class="pmac-marquee-bar color-{{ section.settings.color_scheme }} gradient">
  {%- if section.blocks.size > 0 -%}
    <div
      class="pmac-marquee"
      data-speed="{{ section.settings.speed }}"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      <div class="pmac-marquee__track pmac-mono">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="pmac-marquee__item" {{ block.shopify_attributes }}>{%- else -%}<span class="pmac-marquee__item" {{ block.shopify_attributes }}>{%- endif -%}
              {{ block.settings.text | escape }}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
            <span class="pmac-marquee__sep" aria-hidden="true">//</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_social and social_icons -%}
    <div class="pmac-marquee-bar__social">
      {%- render 'social-icons' -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pmac-marquee-bar {
    display: flex;
    align-items: center;
    height: 3.6rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.14);
  }

  .pmac-marquee-bar .pmac-marquee {
    height: 100%;
  }

  .pmac-marquee__item {
    display: inline-flex;
    padding: 0 0.4em;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    white-space: nowrap;
  }

  a.pmac-marquee__item {
    transition: opacity var(--dur-fast) var(--ease-pmac);
  }

  a.pmac-marquee__item:hover {
    opacity: 0.6;
  }

  .pmac-marquee__sep {
    display: inline-flex;
    align-items: center;
    opacity: 0.4;
    font-size: 1.1rem;
  }

  .pmac-marquee-bar__social {
    flex: none;
    padding: 0 1.6rem;
    border-left: 1px solid rgba(var(--color-foreground), 0.14);
  }

  .pmac-marquee-bar__social .list-social {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Velocità scorrimento (px/s)",
      "default": 60
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
