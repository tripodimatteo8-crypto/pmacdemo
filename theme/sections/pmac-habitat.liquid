{{ 'component-pmac-habitat.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Planet 121 — l'abitazione di PMAC (brief E: "il pianeta e l'abitazione di PMAC").
  Immagine a tutta larghezza con zoom lento legato allo scroll e scheda dati.
{%- endcomment -%}
<div class="pmac-habitat color-{{ section.settings.color_scheme }} gradient" data-pmac-habitat>
  <div class="pmac-habitat__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1600, 2400', alt: section.settings.heading }}
    {%- else -%}
      <img src="{{ 'pmac-habitat.webp' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="2400" height="1340" loading="lazy">
    {%- endif -%}
    <span class="pmac-habitat__shade" aria-hidden="true"></span>
  </div>

  <div class="page-width pmac-habitat__grid">
    <div class="pmac-habitat__copy pmac-reveal-group">
      <p class="pmac-system-label" data-pmac-scramble="{{ section.settings.label | escape }}">{{ section.settings.label }}</p>
      <h2 class="pmac-habitat__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="pmac-habitat__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <dl class="pmac-habitat__data pmac-mono">
      {%- for block in section.blocks -%}
        <div class="pmac-habitat__datum" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.key }}</dt>
          <dd>{{ block.settings.value }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-pmac-habitat]');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const img = root.querySelector('.pmac-habitat__media img');
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom < 0 || r.top > vh) return;
      const p = Math.min(Math.max((vh - r.top) / (vh + r.height), 0), 1);
      img.style.transform = `scale(${1.14 - p * 0.14}) translate3d(0, ${(p - 0.5) * -4}%, 0)`;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((e) => { if (e[0].isIntersecting) root.classList.add('is-in-view'); }, { threshold: 0.3 }).observe(root);
    } else {
      root.classList.add('is-in-view');
    }
  })();
</script>

{% schema %}
{
  "name": "PMAC — Habitat",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine (vuoto = immagine del tema)" },
    { "type": "text", "id": "label", "label": "Testo di sistema", "default": "HABITAT // SECTOR 07" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "The Dwelling" },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Before Earth, there was a single door of light on a silent planet. This is where PMAC lives between transmissions: a steel shelter half-buried in the rock of Planet 121, facing the horizon it left behind.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "datum",
      "name": "Dato",
      "settings": [
        { "type": "text", "id": "key", "label": "Voce", "default": "COORDINATES" },
        { "type": "text", "id": "value", "label": "Valore", "default": "12.0121° S, 121.0000° E" }
      ]
    }
  ],
  "presets": [ { "name": "PMAC — Habitat" } ]
}
{% endschema %}
