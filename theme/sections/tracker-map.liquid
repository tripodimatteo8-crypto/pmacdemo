{{ 'component-tracker-map.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="pmac-tracker-map-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width pmac-tracker-map-section__intro pmac-reveal-group">
    <p class="pmac-system-label" data-pmac-scramble="{{ section.settings.label | escape }}">
      {{ section.settings.label }}
    </p>
    <h1 class="pmac-tracker-map-section__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="pmac-tracker-map-section__text rte">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>

  <pmac-tracker-map class="pmac-tracker-map">
    <div class="pmac-tracker-map__toolbar">
      <button type="button" class="pmac-tracker-map__zoom-btn" data-tracker-zoom-out aria-label="Zoom out">−</button>
      <button type="button" class="pmac-tracker-map__zoom-btn" data-tracker-zoom-reset aria-label="Reset zoom">RESET</button>
      <button type="button" class="pmac-tracker-map__zoom-btn" data-tracker-zoom-in aria-label="Zoom in">+</button>
    </div>

    <div class="pmac-tracker-map__viewport" data-tracker-viewport></div>

    <script type="application/json" data-tracker-pins>
      [
        {%- for block in section.blocks -%}
          {%- if block.type == 'statuetta' -%}
            {%- liquid
              assign is_taken = false
              if block.settings.product != blank and block.settings.product.available == false
                assign is_taken = true
              endif
            -%}
            {
              "target": "pin-{{ forloop.index }}",
              "city": {{ block.settings.city | default: 'Statuetta' | json }},
              "coordinates": {{ block.settings.coordinates | json }},
              "status": {{ block.settings.status | json }},
              "isTaken": {{ is_taken }},
              "number": {{ block.settings.number | default: forloop.index | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
  </pmac-tracker-map>

  <div class="pmac-tracker-card" data-tracker-card aria-hidden="true">
    <span class="pmac-tracker-card__scrim" data-tracker-card-close></span>
    <div class="pmac-tracker-card__panel" role="dialog" aria-modal="true">
      <button type="button" class="pmac-tracker-card__close" data-tracker-card-close aria-label="Chiudi">×</button>
      <div class="pmac-tracker-card__content" data-tracker-card-content></div>
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'statuetta' -%}
      {%- liquid
        assign is_taken = false
        if block.settings.product != blank and block.settings.product.available == false
          assign is_taken = true
        endif

        case block.settings.status
          when 'located'
            assign status_label = 'PMAC LOCATED'
          when 'active'
            assign status_label = 'ACTIVE'
          when 'signal_lost'
            assign status_label = 'SIGNAL LOST'
          else
            assign status_label = 'SIGNAL DETECTED'
        endcase
      -%}
      <template data-tracker-template="pin-{{ forloop.index }}">
        <div class="pmac-tracker-card__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900' }}
          {%- else -%}
            <img src="{{ 'pmac-tracker-pin-placeholder.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          {%- endif -%}
        </div>
        <div class="pmac-tracker-card__body">
          <p class="pmac-system-label pmac-system-label--static">
            PMAC N°{{ block.settings.number | default: forloop.index }}/10 — {{ block.settings.city }}
          </p>
          <span class="pmac-tracker-card__status pmac-mono{% if is_taken %} is-taken{% endif %}">
            {% if is_taken %}COLLECTED{% else %}{{ status_label }}{% endif %}
          </span>
          {%- if block.settings.coordinates != blank -%}
            <p class="pmac-tracker-card__coords pmac-mono">{{ block.settings.coordinates }}</p>
          {%- endif -%}
          {%- if block.settings.video != blank -%}
            <div class="pmac-tracker-card__video">
              {{ block.settings.video | video_tag: controls: true, muted: true, image_size: '900x' }}
            </div>
          {%- endif -%}
          {%- if block.settings.sighting_info != blank -%}
            <div class="pmac-tracker-card__sighting rte">{{ block.settings.sighting_info }}</div>
          {%- endif -%}
          {%- if block.settings.sighting_datetime != blank -%}
            <p class="pmac-tracker-card__datetime pmac-mono">{{ block.settings.sighting_datetime }}</p>
          {%- endif -%}
          {%- if block.settings.clue != blank -%}
            <p class="pmac-tracker-card__clue">{{ block.settings.clue }}</p>
          {%- endif -%}
          {%- if block.settings.product != blank -%}
            <a href="{{ block.settings.product.url }}" class="pmac-link pmac-tracker-card__link">
              {% if is_taken %}View Piece{% else %}Shop{% endif %}
            </a>
          {%- endif -%}
        </div>
      </template>
    {%- endif -%}
  {%- endfor -%}
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer="defer"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js" defer="defer"></script>
<script src="{{ 'pmac-supabase-client.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'pmac-tracker-map.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'pmac-tracker-community.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "PMAC — Tracker",
  "tag": "section",
  "class": "section section--pmac-tracker-map",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Testo di sistema",
      "default": "PHASE 03 // SIGHTED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "PMAC Tracker"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Testo introduttivo",
      "default": "<p>Ten signals, one each, intercepted on Earth. Touch one on the map to open the file.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "statuetta",
      "name": "Statuetta",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto statuetta"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Numero (es. 01)"
        },
        {
          "type": "text",
          "id": "city",
          "label": "Città"
        },
        {
          "type": "text",
          "id": "coordinates",
          "label": "Coordinate (testo)",
          "info": "Es. 41.9028° N, 12.4964° E — usate anche per posizionare il pin sulla mappa reale"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video avvistamento (opzionale)"
        },
        {
          "type": "richtext",
          "id": "sighting_info",
          "label": "Informazioni sull'avvistamento"
        },
        {
          "type": "text",
          "id": "sighting_datetime",
          "label": "Data e ora avvistamento",
          "info": "Testo libero, es. 09.10.2026 — 23:44"
        },
        {
          "type": "textarea",
          "id": "clue",
          "label": "Indizio"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status narrativo",
          "options": [
            { "value": "signal_detected", "label": "Signal detected" },
            { "value": "located", "label": "PMAC Located" },
            { "value": "active", "label": "Active" },
            { "value": "signal_lost", "label": "Signal lost" }
          ],
          "default": "signal_detected",
          "info": "\"Collected\" viene mostrato automaticamente quando il prodotto collegato risulta esaurito."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Prodotto collegato"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PMAC — Tracker",
      "blocks": [
        { "type": "statuetta" },
        { "type": "statuetta" },
        { "type": "statuetta" }
      ]
    }
  ]
}
{% endschema %}
