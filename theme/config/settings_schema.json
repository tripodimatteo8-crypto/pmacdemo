  {
    "name": "PMAC — Sistema",
    "settings": [
      {
        "type": "header",
        "content": "Metallo / cromo"
      },
      {
        "type": "color",
        "id": "chrome_color_1",
        "label": "Cromo — tono scuro",
        "default": "#6E737A"
      },
      {
        "type": "color",
        "id": "chrome_color_2",
        "label": "Cromo — tono chiaro (riflesso)",
        "default": "#F2F3F5"
      },
      {
        "type": "color",
        "id": "chrome_color_3",
        "label": "Cromo — tono medio",
        "default": "#A7ABB2"
      },
      {
        "type": "range",
        "id": "chrome_sheen_intensity",
        "label": "Intensità riflesso cromo su hover",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 65
      },
      {
        "type": "header",
        "content": "Segnale"
      },
      {
        "type": "color",
        "id": "signal_color",
        "label": "Colore segnale (stato live / avvistamento)",
        "default": "#C73B2F"
      },
      {
        "type": "color",
        "id": "hazard_color",
        "label": "Giallo nastro PMAC (box / lancio)",
        "default": "#F2C230",
        "info": "Usato solo per il nastro giallo-nero della Box Contagio e dell'animazione di lancio."
      },
      {
        "type": "header",
        "content": "Dettagli industriali"
      },
      {
        "type": "checkbox",
        "id": "enable_cut_corners",
        "label": "Angoli tagliati su card e bottoni",
        "default": true
      },
      {
        "type": "header",
        "content": "Movimento"
      },
      {
        "type": "checkbox",
        "id": "enable_smooth_scroll",
        "label": "Scroll fluido (desktop)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_custom_cursor",
        "label": "Cursore personalizzato (desktop con mouse)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_page_transitions",
        "label": "Transizioni fluide tra pagine",
        "default": true
      },
      {
        "type": "header",
        "content": "Coniglio PMAC"
      },
      {
        "type": "image_picker",
        "id": "pmac_rabbit_image",
        "label": "Immagine coniglio PMAC",
        "info": "Se vuota viene usato il placeholder del tema."
      },
      {
        "type": "checkbox",
        "id": "enable_pmac_rabbit",
        "label": "Mostra il coniglio PMAC durante la navigazione",
        "default": true
      },
      {
        "type": "range",
        "id": "pmac_rabbit_frequency",
        "label": "Frequenza comparsa (minuti)",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "min",
        "default": 3
      },
      {
        "type": "header",
        "content": "Fase narrativa del lancio"
      },
      {
        "type": "select",
        "id": "pmac_phase",
        "label": "Fase attiva",
        "default": "3",
        "options": [
          {
            "value": "1",
            "label": "01 — Signal detected (viaggio)"
          },
          {
            "value": "2",
            "label": "02 — PMAC has been sighted"
          },
          {
            "value": "3",
            "label": "03 — Statuette localizzate"
          },
          {
            "value": "4",
            "label": "04 — Contamination in progress"
          },
          {
            "value": "5",
            "label": "05 — Collection revealed"
          }
        ],
        "info": "Cambia indicatore di stato, messaggi e livello di interferenza su tutto il sito. In fase 04 compare l'effetto contaminazione."
      },
      {
        "type": "text",
        "id": "pmac_phase_message",
        "label": "Messaggio di fase (opzionale)",
        "info": "Se vuoto usa il testo standard della fase (es. CONTAMINATION IN PROGRESS)."
      },
      {
        "type": "header",
        "content": "Intro del portale"
      },
      {
        "type": "checkbox",
        "id": "enable_pmac_intro",
        "label": "Mostra l'intro animata in homepage",
        "default": true,
        "info": "Una sola volta per sessione, si salta con un click. Dura circa 2 secondi."
      },
      {
        "type": "textarea",
        "id": "pmac_intro_lines",
        "label": "Righe dell'intro (una per riga)",
        "default": "ESTABLISHING LINK — EARTH ⇄ PLANET 121\nCALIBRATING RADAR ARRAY\nSIGNAL ACQUIRED"
      },
      {
        "type": "header",
        "content": "Notifiche di sistema"
      },
      {
        "type": "checkbox",
        "id": "enable_pmac_signals",
        "label": "Mostra notifiche durante la navigazione",
        "default": true
      },
      {
        "type": "textarea",
        "id": "pmac_signal_messages",
        "label": "Messaggi (uno per riga)",
        "default": "NEW SIGNAL DETECTED — MILAN\nPMAC #07 HAS BEEN LOCATED — AMSTERDAM\nTRANSMISSION RECEIVED\nANOMALY LOGGED — 41.9028° N, 12.4964° E\nPMAC SIGHTING CONFIRMED — PARIS"
      },
      {
        "type": "range",
        "id": "pmac_signal_interval",
        "label": "Intervallo tra notifiche",
        "min": 10,
        "max": 90,
        "step": 5,
        "unit": "s",
        "default": 25
      },
      {
        "type": "range",
        "id": "pmac_signal_max",
        "label": "Massimo notifiche per sessione",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 4
      },
      {
        "type": "header",
        "content": "Drop programmato"
      },
      {
        "type": "checkbox",
        "id": "pmac_drop_enabled",
        "label": "Attiva drop programmato",
        "default": true
      },
      {
        "type": "text",
        "id": "pmac_drop_datetime",
        "label": "Apertura (data e ora)",
        "default": "2026-11-06T18:00:00+01:00",
        "info": "Formato AAAA-MM-GGTHH:MM:SS+01:00. Prima di questa data i prodotti del drop sono bloccati, poi diventano acquistabili da soli."
      },
      {
        "type": "textarea",
        "id": "pmac_drop_products",
        "label": "Prodotti del drop (handle, uno per riga)",
        "default": "statuetta-pmac-n-09-athens\nstatuetta-pmac-n-10-warsaw",
        "info": "In alternativa aggiungi al prodotto il tag drop:AAAA-MM-GGTHH:MM (es. drop:2026-12-01T18:00)."
      },
      {
        "type": "select",
        "id": "pmac_drop_label",
        "label": "Stato mostrato prima dell'apertura",
        "default": "CLASSIFIED",
        "options": [
          {
            "value": "CLASSIFIED",
            "label": "CLASSIFIED"
          },
          {
            "value": "SIGNAL LOCKED",
            "label": "SIGNAL LOCKED"
          },
          {
            "value": "TRANSMISSION PENDING",
            "label": "TRANSMISSION PENDING"
          }
        ]
      },
      {
        "type": "header",
        "content": "Menu"
      },
      {
        "type": "text",
        "id": "pmac_extra_nav_label",
        "label": "Voce extra nel menu",
        "default": "Archive",
        "info": "Aggiunta in fondo al menu principale. Lascia vuoto per nasconderla."
      },
      {
        "type": "url",
        "id": "pmac_extra_nav_url",
        "label": "Link voce extra",
        "default": "/collections"
      }
    ]
  },
