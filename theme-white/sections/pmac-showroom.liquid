{{ 'component-pmac-showroom.css' | asset_url | stylesheet_tag }}

<div id="pmac-showroom" class="pmac-showroom color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.label != blank -%}
      <p class="pmac-system-label pmac-showroom__label" data-pmac-scramble="{{ section.settings.label | escape }}">
        {{ section.settings.label }}
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pmac-showroom__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pmac-showroom__grid pmac-reveal-group">
      {%- for block in section.blocks -%}
        <figure class="pmac-showroom__tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 700, 1000, 1400'
            }}
          {%- else -%}
            <img
              src="{{ 'pmac-showroom-' | append: forloop.index | append: '.webp' | asset_url }}"
              alt=""
              width="1400"
              height="1400"
              loading="lazy"
            >
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="pmac-showroom__caption pmac-mono">{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PMAC — Showroom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Testo di sistema",
      "default": "ARCHIVE // MATERIAL STUDY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Showroom"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine (placeholder se vuoto)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Didascalia (monospazio, opzionale)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PMAC — Showroom",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
