{{ 'component-pmac-launch.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Animazione finale dopo l'ordine (brief F): box → sigillo → nastro giallo-nero →
  caricamento sul razzo → lancio → "spedizione partita".
  In produzione va mostrata nella pagina di ringraziamento del checkout Shopify
  (Checkout UI extension / app); qui vive come pagina del tema per la bozza.
{%- endcomment -%}
{%- liquid
  assign lines = section.settings.lines | newline_to_br | split: '<br />'
-%}
<div class="pmac-launch color-{{ section.settings.color_scheme }} gradient{% unless section.settings.show_box %} pmac-launch--rocket-only{% endunless %}" data-pmac-launch data-box="{{ section.settings.show_box }}">
  <div class="pmac-launch__hud pmac-mono" aria-hidden="true">
    <span>PMAC // LAUNCH CONTROL</span>
    <span data-launch-clock>T-00:00:09</span>
  </div>

  <div class="pmac-launch__stage">
    {%- if section.settings.show_box -%}
    <div class="pmac-launch__rocket" aria-hidden="true">
      <svg viewBox="0 0 120 250" class="pmac-launch__rocket-svg">
        <g class="pmac-launch__rocket-body">
          <path class="pmac-launch__rdraw" d="M60 6 C82 30 92 70 92 120 L92 180 L28 180 L28 120 C28 70 38 30 60 6 Z"></path>
          <path class="pmac-launch__rdraw" d="M28 146 L8 198 L28 188 Z"></path>
          <path class="pmac-launch__rdraw" d="M92 146 L112 198 L92 188 Z"></path>
          <path class="pmac-launch__rdraw" d="M44 180 L40 196 L80 196 L76 180"></path>
          <line class="pmac-launch__rdraw" x1="60" y1="140" x2="60" y2="180"></line>
          <rect class="pmac-launch__rdraw pmac-launch__hatch" x="44" y="92" width="32" height="32"></rect>
          <rect class="pmac-launch__hatch-fill" x="44" y="92" width="32" height="32" style="fill: url(#PmacLaunchHazard)"></rect>
          <g class="pmac-launch__flame">
            <path d="M44 198 Q50 226 60 246 Q70 226 76 198 Z"></path>
            <path d="M52 198 Q56 214 60 228 Q64 214 68 198 Z"></path>
          </g>
        </g>
      </svg>
    </div>
    <div class="pmac-launch__box" aria-hidden="true">
      <svg viewBox="0 0 240 200" class="pmac-launch__box-svg">
        <defs>
          <pattern id="PmacLaunchHazard" width="14" height="14" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
            <rect width="14" height="14" style="fill: var(--pmac-hazard, #F2C230)"></rect>
            <rect width="7" height="14" style="fill: #111111"></rect>
          </pattern>
        </defs>
        <g class="pmac-launch__box-body">
          <rect class="pmac-launch__draw" x="40" y="60" width="160" height="120"></rect>
          <path class="pmac-launch__draw pmac-launch__flap pmac-launch__flap--l" d="M40 60 L120 60 L100 30 L28 30 Z"></path>
          <path class="pmac-launch__draw pmac-launch__flap pmac-launch__flap--r" d="M200 60 L120 60 L140 30 L212 30 Z"></path>
          <line class="pmac-launch__draw" x1="120" y1="60" x2="120" y2="180"></line>
          <text class="pmac-launch__label" x="120" y="132" text-anchor="middle">PMAC</text>
          <g class="pmac-launch__tape">
            <rect x="20" y="108" width="200" height="20" transform="rotate(-28 120 118)" style="fill: url(#PmacLaunchHazard)"></rect>
            <rect x="20" y="108" width="200" height="20" transform="rotate(28 120 118)" style="fill: url(#PmacLaunchHazard)"></rect>
          </g>
        </g>
      </svg>
    </div>
    {%- endif -%}

    <div class="pmac-launch__film" aria-hidden="true">
      <video
        src="{{ 'pmac-launch.mp4' | asset_url }}"
        poster="{{ 'pmac-launch-poster.webp' | asset_url }}"
        muted
        playsinline
        preload="auto"
        data-launch-video
      ></video>
    </div>
  </div>

  <div class="page-width pmac-launch__panel">
    <ol class="pmac-launch__log pmac-mono" data-launch-log>
      {%- for line in lines -%}
        {%- assign l = line | strip -%}
        {%- if l != blank -%}
          <li><span class="pmac-launch__t" data-t></span>{{ l | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ol>

    <div class="pmac-launch__final">
      <p class="pmac-system-label pmac-system-label--static">{{ section.settings.final_label }}</p>
      <h1 class="pmac-launch__heading">{{ section.settings.heading }}</h1>
      <div class="pmac-launch__text rte">{{ section.settings.text }}</div>
      <div class="pmac-launch__links">
        <a class="pmac-link" href="{{ section.settings.link_1_url | default: '/pages/pmac-tracker' }}">{{ section.settings.link_1_label }}</a>
        <a class="pmac-link" href="{{ section.settings.link_2_url | default: '/' }}">{{ section.settings.link_2_label }}</a>
      </div>
    </div>
  </div>

  <button type="button" class="pmac-launch__replay pmac-mono" data-launch-replay>REPLAY ↺</button>
</div>

<script src="{{ 'pmac-launch.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "PMAC — Lancio post-ordine",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_box", "label": "Mostra la box (chiusura, nastro, carico sul razzo)", "default": true, "info": "Spento: solo il video del decollo." },
    { "type": "textarea", "id": "lines", "label": "Messaggi della sequenza (uno per riga)",
      "default": "ORDER TRANSMISSION CONFIRMED\nBOX SEALED // PMAC TAPE APPLIED\nCONTAGION LOADED ON ROCKET\nPMAC PACKAGE LAUNCHED\nDELIVERY TO EARTH IN PROGRESS" },
    { "type": "text", "id": "final_label", "label": "Testo di sistema finale", "default": "MISSION STARTED" },
    { "type": "text", "id": "heading", "label": "Titolo finale", "default": "Your contagion is on its way" },
    { "type": "richtext", "id": "text", "label": "Testo finale", "default": "<p>The PMAC box has left the monitoring center. You will receive the tracking coordinates by email as soon as it enters Earth's orbit.</p>" },
    { "type": "text", "id": "link_1_label", "label": "Link 1", "default": "Track the signal" },
    { "type": "url", "id": "link_1_url", "label": "URL link 1" },
    { "type": "text", "id": "link_2_label", "label": "Link 2", "default": "Back to the portal" },
    { "type": "url", "id": "link_2_url", "label": "URL link 2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [ { "name": "PMAC — Lancio post-ordine" } ]
}
{% endschema %}
