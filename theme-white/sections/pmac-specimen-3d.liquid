{{ 'component-pmac-specimen-3d.css' | asset_url | stylesheet_tag }}
<script type="module" src="https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js" defer="defer"></script>

<div class="pmac-specimen color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width pmac-specimen__grid pmac-reveal-group">
    <div class="pmac-specimen__content">
      <p class="pmac-system-label" data-pmac-scramble="{{ section.settings.label | escape }}">
        {{ section.settings.label }}
      </p>
      <h2 class="pmac-specimen__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="pmac-specimen__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <p class="pmac-specimen__hint pmac-mono">DRAG TO ROTATE // SCROLL TO ZOOM</p>
    </div>

    <div class="pmac-specimen__viewer-wrap">
      <model-viewer
        class="pmac-specimen__viewer"
        src="{{ 'pmac-rabbit-3d.glb' | asset_url }}"
        poster="{{ 'pmac-rabbit-3d-poster.webp' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        camera-controls
        auto-rotate
        auto-rotate-delay="1200"
        rotation-per-second="18deg"
        interaction-prompt="none"
        shadow-intensity="0"
        environment-image="legacy"
        exposure="0.9"
        loading="lazy"
        reveal="auto"
      ></model-viewer>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PMAC — Specimen 3D",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Testo di sistema",
      "default": "SPECIMEN 01 // RECOVERED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "The Rabbit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Scanned and reconstructed from the recovered specimen. One of ten signals, now in three dimensions.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "PMAC — Specimen 3D"
    }
  ]
}
{% endschema %}
